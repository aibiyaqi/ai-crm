# ============================================================
# 通义千问 API 配置（复制此文件为 .env 后填入真实 Key）
# ============================================================
# 获取地址：https://dashscope.aliyun.com/ → API Key 管理
# 安全提醒：.env 已加入 .gitignore，不会上传到 GitHub
# ============================================================
QWEN_API_KEY=your_api_key_here

# ==================== 管理员初始账户 ====================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_PHONE=13800000000

# ==================== 数据库：引擎切换位 ====================
# sqlite = 本地开发/回滚（零依赖）；mysql = 生产默认
DB_ENGINE=sqlite
DB_SQLITE_PATH=crm.db

# MySQL 连接（DB_ENGINE=mysql 时生效）
DB_MYSQL_HOST=127.0.0.1
DB_MYSQL_PORT=3306
DB_MYSQL_USER=crm_app
DB_MYSQL_PASSWORD=crm_dev_pass
DB_MYSQL_DATABASE=crm

# 连接池（池满时阻塞等待，不会直接抛连接异常）
DB_MYSQL_POOL_SIZE=10
DB_MYSQL_MAX_OVERFLOW=20
DB_MYSQL_POOL_RECYCLE=1800

# 字符集与时区（应用侧 datetime.now() 与 MySQL 会话时区保持一致）
DB_MYSQL_CHARSET=utf8mb4
DB_MYSQL_TIMEZONE=+08:00
DB_MYSQL_CONNECT_TIMEOUT=5

# 只读账号（NL2SQL 专用；留空则用主账号 + 会话级只读兜底）
# 生产建议：GRANT SELECT ON crm.* TO 'crm_ro'@'%' IDENTIFIED BY '...';
DB_MYSQL_READONLY_USER=
DB_MYSQL_READONLY_PASSWORD=

# ==================== Redis（缓存 / 限流 / 延迟队列 / 分布式锁） ====================
# Redis 不可用时全部能力自动降级，不阻断主链路
REDIS_ENABLED=1
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20
REDIS_TIMEOUT_S=1.0
REDIS_BREAKER_THRESHOLD=5
REDIS_BREAKER_COOLDOWN_S=30

# 各场景 TTL（秒）
REDIS_SESSION_TTL=604800         # 会话令牌 7 天
REDIS_LOGIN_FAIL_TTL=900         # 登录失败计数 15 分钟
REDIS_HISTORY_TTL=1800           # 对话热缓存 30 分钟
REDIS_ALERT_DEDUP_TTL=86400      # 告警去重 24 小时
REDIS_SCAN_LOCK_TTL=300          # 跑批锁 5 分钟

# 意图识别缓存（Redis 优先 + LRU 兜底）
INTENT_CACHE_TTL=604800          # 缓存过期秒数（默认 7 天）
INTENT_CACHE_MAXSIZE=200         # LRU 兜底最大条目数
INTENT_CACHE_PREFIX=crm:intent:  # Redis key 前缀

# 限流存储：redis（多 worker 阈值共享）/ memory（单进程，压测用）
RATE_LIMIT_STORAGE=redis
# RATE_LIMIT_ENABLED=0           # 压测时可整体关闭限流
# RATE_LIMIT_CHAT=30/minute
# RATE_LIMIT_STATUS=30/minute

# ==================== 定时调度与异常筛查（分层跑批） ====================
EVENT_INTERVAL_SECONDS=60        # 事件消费者轮询间隔（秒）
COARSE_HOUR=21                   # 粗筛小时（销售收尾，全表扫描入待办池）
FINE_HOUR=13                     # 精筛小时（次日销售开机，只扫待办池）
RUN_WINDOW_MINUTES=5             # 时间窗容差（分钟）
DELAY_DAYS=10                    # 事件驱动延迟触发天数
FOLLOW_UP_DUE_DAYS=14            # 跟进超期天数阈值
PUBLIC_POOL_DAYS=45              # 45 天未转化自动入公海
